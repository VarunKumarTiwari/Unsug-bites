{
  "expo": {
    "name": "Unsung Bites",
    "slug": "shauni",
    "version": "0.0.1",
    "scheme": "shauni",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#FDFCF7",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unsung.bites"
    },
    "android": {
      "package": "com.unsung.bites",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDFCF7"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        { "cameraPermission": "Unsung Bites uses your camera to scan dishes for ingredient + nutrition info." }
      ],
      [
        "expo-location",
        { "locationWhenInUsePermission": "Unsung Bites uses your location to show hidden-gem restaurants near you." }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
