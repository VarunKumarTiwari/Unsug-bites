# Copy to `.env` (Expo auto-loads EXPO_PUBLIC_* into the app bundle).

# Backend base URL. Defaults to the Render deploy if unset.
EXPO_PUBLIC_API_URL=https://unsung-bites-api.onrender.com

# Set to 1 to force mock data and never hit the network (offline/dev).
EXPO_PUBLIC_USE_MOCK=0

# Supabase auth (login lives in the app, not the marketing site).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# MapTiler tile key for the Map view. Without it the map shows a placeholder.
# NOTE: restrict the key by "Allowed user-agent header" for native (iOS/Android
# send NO HTTP Origin, so an origin-only restriction rejects them). Add your web
# origin(s) too if you also lock HTTP Origins. See specs/map-view-frontend.md R2.
EXPO_PUBLIC_MAPTILER_KEY=your-maptiler-key
